{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buyer-ops.example/schemas/production-runtime/1.0.0",
  "title": "Production runtime binding records",
  "oneOf": [
    { "$ref": "#/$defs/JourneyStateDerivation" },
    { "$ref": "#/$defs/OperatorWorkflowCommandBinding" },
    { "$ref": "#/$defs/CapabilityActivationBinding" },
    { "$ref": "#/$defs/TelemetryEventBinding" },
    { "$ref": "#/$defs/AccessibilityBinding" },
    { "$ref": "#/$defs/WorkerConfiguration" }
  ],
  "$defs": {
    "Id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "Version": { "type": "string", "minLength": 1 },
    "Timestamp": { "type": "string", "format": "date-time" },
    "Digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "Ref": {
      "type": "object", "additionalProperties": false,
      "required": ["recordId", "recordType", "recordVersion", "digest"],
      "properties": {
        "recordId": { "$ref": "#/$defs/Id" },
        "recordType": { "$ref": "#/$defs/Id" },
        "recordVersion": { "type": "integer", "minimum": 1 },
        "digest": { "$ref": "#/$defs/Digest" }
      }
    },
    "Base": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "recordId", "recordVersion", "tenantId", "effectiveFrom", "status", "evidenceRefs"],
      "properties": {
        "schemaVersion": { "const": "production-runtime/1.0.0" },
        "recordId": { "$ref": "#/$defs/Id" },
        "recordVersion": { "type": "integer", "minimum": 1 },
        "tenantId": { "$ref": "#/$defs/Id" },
        "effectiveFrom": { "$ref": "#/$defs/Timestamp" },
        "effectiveTo": { "$ref": "#/$defs/Timestamp" },
        "status": { "enum": ["draft", "current", "superseded", "revoked", "expired"] },
        "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Ref" } }
      }
    },
    "JourneyStateDerivation": {
      "allOf": [
        { "$ref": "#/$defs/Base" },
        { "type": "object", "required": ["recordType", "derivationVersion", "sourceRecordTypes", "stateFields", "precedence", "unknownState", "outputSchemaVersion"], "properties": {
          "recordType": { "const": "JourneyStateDerivation" },
          "derivationVersion": { "$ref": "#/$defs/Version" },
          "sourceRecordTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
          "stateFields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
          "precedence": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["stateField", "orderedRules"], "properties": { "stateField": { "$ref": "#/$defs/Id" }, "orderedRules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Id" } } } } },
          "unknownState": { "$ref": "#/$defs/Id" },
          "outputSchemaVersion": { "const": "ot01-journey-state/1.0.0" }
        }}
      ]
    },
    "OperatorWorkflowCommandBinding": {
      "allOf": [
        { "$ref": "#/$defs/Base" },
        { "type": "object", "required": ["recordType", "commandType", "targetRecordTypes", "temporalSignal", "idempotencyScope", "expectedVersionRequired", "resultRecordType", "canonicalMutationAtomicity"], "properties": {
          "recordType": { "const": "OperatorWorkflowCommandBinding" },
          "commandType": { "enum": ["pause_workflow", "resume_workflow", "request_reconciliation"] },
          "targetRecordTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "const": "WorkflowReference" } },
          "temporalSignal": { "$ref": "#/$defs/Id" },
          "idempotencyScope": { "enum": ["tenant_command", "journey_command", "workflow_command"] },
          "expectedVersionRequired": { "const": true },
          "resultRecordType": { "const": "CommandResult" },
          "canonicalMutationAtomicity": { "const": "command_result_and_workflow_reference_same_transaction" }
        }}
      ]
    },
    "CapabilityActivationBinding": {
      "allOf": [
        { "$ref": "#/$defs/Base" },
        { "type": "object", "required": ["recordType", "connectorId", "capabilityId", "activationRecordRef", "inventoryRecordRef", "actionClasses", "channel", "authorityScopes", "revalidationRequired"], "properties": {
          "recordType": { "const": "CapabilityActivationBinding" },
          "connectorId": { "$ref": "#/$defs/Id" },
          "capabilityId": { "$ref": "#/$defs/Id" },
          "activationRecordRef": { "$ref": "#/$defs/Ref" },
          "inventoryRecordRef": { "$ref": "#/$defs/Ref" },
          "actionClasses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
          "channel": { "enum": ["email", "sms", "calendar", "documents", "cognition", "web", "ios"] },
          "authorityScopes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
          "revalidationRequired": { "const": true }
        }}
      ]
    },
    "TelemetryEventBinding": {
      "allOf": [
        { "$ref": "#/$defs/Base" },
        { "type": "object", "required": ["recordType", "metricId", "startEventType", "endEventType", "correlationKey", "numeratorEventSetDigest", "denominatorEventSetDigest", "dimensions", "window", "thresholds", "ownerId", "retentionClass"], "properties": {
          "recordType": { "const": "TelemetryEventBinding" },
          "metricId": { "$ref": "#/$defs/Id" },
          "startEventType": { "$ref": "#/$defs/Id" },
          "endEventType": { "$ref": "#/$defs/Id" },
          "correlationKey": { "$ref": "#/$defs/Id" },
          "numeratorEventSetDigest": { "$ref": "#/$defs/Digest" },
          "denominatorEventSetDigest": { "$ref": "#/$defs/Digest" },
          "dimensions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
          "window": { "$ref": "#/$defs/Id" },
          "thresholds": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "number" } },
          "ownerId": { "$ref": "#/$defs/Id" },
          "retentionClass": { "$ref": "#/$defs/Id" }
        }}
      ]
    },
    "AccessibilityBinding": {
      "allOf": [
        { "$ref": "#/$defs/Base" },
        { "type": "object", "required": ["recordType", "operatorAcceptanceRef", "closureEvidenceRef", "surface", "buildDigest", "expiresAt", "bindingDigest"], "properties": {
          "recordType": { "const": "AccessibilityBinding" },
          "operatorAcceptanceRef": { "$ref": "#/$defs/Ref" },
          "closureEvidenceRef": { "$ref": "#/$defs/Ref" },
          "surface": { "enum": ["web", "ios", "web_and_ios"] },
          "buildDigest": { "$ref": "#/$defs/Digest" },
          "expiresAt": { "$ref": "#/$defs/Timestamp" },
          "bindingDigest": { "$ref": "#/$defs/Digest" }
        }}
      ]
    },
    "WorkerConfiguration": {
      "allOf": [
        { "$ref": "#/$defs/Base" },
        { "type": "object", "required": ["recordType", "workerId", "taskQueue", "workflowTypes", "activityTypes", "maxConcurrentWorkflowTasks", "maxConcurrentActivities", "maxCachedWorkflows", "gracefulShutdownSeconds", "deploymentDigest"], "properties": {
          "recordType": { "const": "WorkerConfiguration" },
          "workerId": { "$ref": "#/$defs/Id" },
          "taskQueue": { "$ref": "#/$defs/Id" },
          "workflowTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
          "activityTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
          "maxConcurrentWorkflowTasks": { "type": "integer", "minimum": 1 },
          "maxConcurrentActivities": { "type": "integer", "minimum": 1 },
          "maxCachedWorkflows": { "type": "integer", "minimum": 1 },
          "gracefulShutdownSeconds": { "type": "integer", "minimum": 1 },
          "deploymentDigest": { "$ref": "#/$defs/Digest" }
        }}
      ]
    }
  }
}
