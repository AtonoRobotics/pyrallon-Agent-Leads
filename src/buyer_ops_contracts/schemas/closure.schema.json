{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buyer-ops.example/schemas/open-019-024-closure/1.0.0",
  "title": "OPEN-019–024 governing closure records",
  "oneOf": [
    { "$ref": "#/$defs/ExternalMessageIdentity" },
    { "$ref": "#/$defs/CapabilityInventory" },
    { "$ref": "#/$defs/EffectDraftPreview" },
    { "$ref": "#/$defs/ContextSourceFreshness" },
    { "$ref": "#/$defs/OutputClassMapping" },
    { "$ref": "#/$defs/MetricDefinition" },
    { "$ref": "#/$defs/MetricObservation" },
    { "$ref": "#/$defs/ReleaseEvidence" },
    { "$ref": "#/$defs/AccessibilityEvidence" }
  ],
  "$defs": {
    "Id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "Timestamp": { "type": "string", "format": "date-time" },
    "Digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "Version": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "Base": {
      "type": "object",
      "required": ["schemaVersion", "tenantId", "recordId", "observedAt"],
      "properties": {
        "schemaVersion": { "const": "open-019-024/1.0.0" },
        "tenantId": { "$ref": "#/$defs/Id" },
        "recordId": { "$ref": "#/$defs/Id" },
        "observedAt": { "$ref": "#/$defs/Timestamp" },
        "expiresAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "ExternalMessageIdentity": {
      "allOf": [{ "$ref": "#/$defs/Base" }, { "type": "object", "required": ["recordType", "connectorId", "provider", "providerAccountRef", "externalMessageId", "payloadDigest"], "properties": {
        "recordType": { "const": "ExternalMessageIdentity" }, "connectorId": { "$ref": "#/$defs/Id" }, "provider": { "$ref": "#/$defs/Id" }, "providerAccountRef": { "$ref": "#/$defs/Id" }, "externalMessageId": { "$ref": "#/$defs/Id" }, "externalEventId": { "$ref": "#/$defs/Id" }, "payloadDigest": { "$ref": "#/$defs/Digest" }
      }}], "unevaluatedProperties": false
    },
    "CapabilityInventory": {
      "allOf": [{ "$ref": "#/$defs/Base" }, { "type": "object", "required": ["recordType", "connectorId", "connectorVersion", "capabilities", "effectClasses", "inventoryDigest", "signature"], "properties": {
        "recordType": { "const": "CapabilityInventory" }, "connectorId": { "$ref": "#/$defs/Id" }, "connectorVersion": { "$ref": "#/$defs/Version" }, "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } }, "effectClasses": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } }, "inventoryDigest": { "$ref": "#/$defs/Digest" }, "signature": { "$ref": "#/$defs/Digest" }
      }}], "unevaluatedProperties": false
    },
    "EffectDraftPreview": {
      "allOf": [{ "$ref": "#/$defs/Base" }, { "type": "object", "required": ["recordType", "connectorId", "capability", "actionClass", "payloadDigest", "targetRefs", "requestedExecutionWindow", "authorityClass", "reversible"], "properties": {
        "recordType": { "const": "EffectDraftPreview" }, "connectorId": { "$ref": "#/$defs/Id" }, "capability": { "$ref": "#/$defs/Id" }, "actionClass": { "$ref": "#/$defs/Id" }, "payloadDigest": { "$ref": "#/$defs/Digest" }, "targetRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Id" } }, "recipientRefs": { "type": "array", "items": { "$ref": "#/$defs/Id" } }, "requestedExecutionWindow": { "type": "object", "additionalProperties": false, "required": ["notBefore", "expiresAt"], "properties": { "notBefore": { "$ref": "#/$defs/Timestamp" }, "expiresAt": { "$ref": "#/$defs/Timestamp" } } }, "authorityClass": { "$ref": "#/$defs/Id" }, "reversible": { "type": "boolean" }
      }}], "unevaluatedProperties": false
    },
    "ContextSourceFreshness": {
      "allOf": [{ "$ref": "#/$defs/Base" }, { "type": "object", "required": ["recordType", "sourceRecordId", "epistemicType", "freshnessAt", "freshUntil"], "properties": {
        "recordType": { "const": "ContextSourceFreshness" }, "sourceRecordId": { "$ref": "#/$defs/Id" }, "epistemicType": { "enum": ["evidence", "assertion", "verified_fact", "inference", "memory"] }, "freshnessAt": { "$ref": "#/$defs/Timestamp" }, "freshUntil": { "$ref": "#/$defs/Timestamp" }
      }}], "unevaluatedProperties": false
    },
    "OutputClassMapping": {
      "allOf": [{ "$ref": "#/$defs/Base" }, { "type": "object", "required": ["recordType", "actionClass", "outputClass", "policyVersion", "groundingMode", "effectEligibility"], "properties": {
        "recordType": { "const": "OutputClassMapping" }, "actionClass": { "$ref": "#/$defs/Id" }, "outputClass": { "$ref": "#/$defs/Id" }, "policyVersion": { "$ref": "#/$defs/Version" }, "groundingMode": { "enum": ["all_claims_grounded", "bounded_unknowns_allowed", "acknowledgment_only"] }, "effectEligibility": { "enum": ["none", "draft_only", "permit_eligible"] }
      }}], "unevaluatedProperties": false
    },
    "MetricDefinition": {
      "allOf": [{ "$ref": "#/$defs/Base" }, { "type": "object", "required": ["recordType", "metricId", "unit", "numeratorEvent", "denominatorEvent", "correlationKey", "dimensions", "window", "minimumDenominator", "zeroDenominatorBehavior"], "properties": {
        "recordType": { "const": "MetricDefinition" }, "metricId": { "$ref": "#/$defs/Id" }, "unit": { "enum": ["ratio", "count", "duration_ms", "percentage"] }, "numeratorEvent": { "$ref": "#/$defs/Id" }, "denominatorEvent": { "$ref": "#/$defs/Id" }, "correlationKey": { "$ref": "#/$defs/Id" }, "dimensions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } }, "window": { "$ref": "#/$defs/Id" }, "minimumDenominator": { "type": "integer", "minimum": 0 }, "zeroDenominatorBehavior": { "enum": ["unknown", "not_applicable", "zero"] }
      }}], "unevaluatedProperties": false
    },
    "MetricObservation": {
      "allOf": [{ "$ref": "#/$defs/Base" }, { "type": "object", "required": ["recordType", "metricId", "windowStart", "windowEnd", "numerator", "denominator", "numeratorEventDigest", "denominatorEventDigest"], "properties": {
        "recordType": { "const": "MetricObservation" }, "metricId": { "$ref": "#/$defs/Id" }, "windowStart": { "$ref": "#/$defs/Timestamp" }, "windowEnd": { "$ref": "#/$defs/Timestamp" }, "numerator": { "type": "integer", "minimum": 0 }, "denominator": { "type": "integer", "minimum": 0 }, "numeratorEventDigest": { "$ref": "#/$defs/Digest" }, "denominatorEventDigest": { "$ref": "#/$defs/Digest" }, "dimensionValues": { "type": "object" }
      }}], "unevaluatedProperties": false
    },
    "ReleaseEvidence": {
      "allOf": [{ "$ref": "#/$defs/Base" }, { "type": "object", "required": ["recordType", "gateId", "applicability", "scope", "testVersion", "outcome", "evidenceRefs", "ownerId", "expiresAt"], "properties": {
        "recordType": { "const": "ReleaseEvidence" }, "gateId": { "$ref": "#/$defs/Id" }, "applicability": { "enum": ["platform_invariant", "operational_thread", "capability", "complete_product"] }, "scope": { "$ref": "#/$defs/Id" }, "testVersion": { "$ref": "#/$defs/Version" }, "outcome": { "enum": ["pass", "fail", "blocked", "not_applicable"] }, "evidenceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Id" } }, "ownerId": { "$ref": "#/$defs/Id" }, "expiresAt": { "$ref": "#/$defs/Timestamp" }
      }}], "unevaluatedProperties": false
    },
    "AccessibilityEvidence": {
      "allOf": [{ "$ref": "#/$defs/Base" }, { "type": "object", "required": ["recordType", "standard", "suiteVersion", "surface", "buildDigest", "assistiveTechnologies", "outcome", "ownerId", "expiresAt"], "properties": {
        "recordType": { "const": "AccessibilityEvidence" }, "standard": { "const": "WCAG 2.2 AA" }, "suiteVersion": { "$ref": "#/$defs/Version" }, "surface": { "$ref": "#/$defs/Id" }, "buildDigest": { "$ref": "#/$defs/Digest" }, "assistiveTechnologies": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Id" } }, "knownExceptions": { "type": "array", "items": { "type": "string" } }, "outcome": { "enum": ["current", "expired", "superseded", "failed", "waived"] }, "ownerId": { "$ref": "#/$defs/Id" }, "expiresAt": { "$ref": "#/$defs/Timestamp" }, "waiverReason": { "type": "string" }, "waiverApproverId": { "$ref": "#/$defs/Id" }
      }}], "unevaluatedProperties": false
    }
  }
}

