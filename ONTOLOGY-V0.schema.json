{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buyer-ops.example/schemas/ontology/buyer-ops/0.3.0",
  "title": "Buyer Operations Ontology v0 Core Records",
  "description": "Executable structural schemas for canonical records required by OT-01 and Texas agreement admission. Transition, temporal, authority, and cross-record invariants in ONTOLOGY-V0-CONTRACT.md remain mandatory.",
  "oneOf": [
    { "$ref": "#/$defs/Tenant" },
    { "$ref": "#/$defs/Brokerage" },
    { "$ref": "#/$defs/LicenseHolder" },
    { "$ref": "#/$defs/ServicePrincipal" },
    { "$ref": "#/$defs/Person" },
    { "$ref": "#/$defs/ContactEndpoint" },
    { "$ref": "#/$defs/BuyingParty" },
    { "$ref": "#/$defs/BuyerJourney" },
    { "$ref": "#/$defs/Conversation" },
    { "$ref": "#/$defs/Message" },
    { "$ref": "#/$defs/ConsentGrant" },
    { "$ref": "#/$defs/Suppression" },
    { "$ref": "#/$defs/LeadSource" },
    { "$ref": "#/$defs/QualificationCriterion" },
    { "$ref": "#/$defs/QualificationObservation" },
    { "$ref": "#/$defs/BuyerRequirement" },
    { "$ref": "#/$defs/FinancingReadiness" },
    { "$ref": "#/$defs/Appointment" },
    { "$ref": "#/$defs/Commitment" },
    { "$ref": "#/$defs/PropertyReference" },
    { "$ref": "#/$defs/DocumentArtifact" },
    { "$ref": "#/$defs/IabsDelivery" },
    { "$ref": "#/$defs/WrittenBuyerAgreement" },
    { "$ref": "#/$defs/AgreementQualification" },
    { "$ref": "#/$defs/RepresentationRelationship" },
    { "$ref": "#/$defs/Transaction" },
    { "$ref": "#/$defs/TransactionMilestone" },
    { "$ref": "#/$defs/Authorization" },
    { "$ref": "#/$defs/Approval" },
    { "$ref": "#/$defs/Evidence" },
    { "$ref": "#/$defs/Assertion" },
    { "$ref": "#/$defs/VerifiedFact" },
    { "$ref": "#/$defs/Inference" },
    { "$ref": "#/$defs/Memory" },
    { "$ref": "#/$defs/Contradiction" },
    { "$ref": "#/$defs/Correction" },
    { "$ref": "#/$defs/WorkflowReference" },
    { "$ref": "#/$defs/EffectAttempt" },
    { "$ref": "#/$defs/ConnectorGrant" },
    { "$ref": "#/$defs/ConfirmedTransactionDate" }
  ],
  "$defs": {
    "Id": { "type": "string", "minLength": 1 },
    "Timestamp": { "type": "string", "format": "date-time" },
    "Digest": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+:[a-fA-F0-9]{32,}$" },
    "ActorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorType", "actorId"],
      "properties": {
        "actorType": { "enum": ["person", "license_holder", "service_principal", "system_migration"] },
        "actorId": { "$ref": "#/$defs/Id" }
      }
    },
    "CanonicalFields": {
      "type": "object",
      "required": [
        "id", "tenantId", "schemaVersion", "recordType", "version", "createdAt", "updatedAt",
        "effectiveFrom", "createdBy", "sourceEvidenceIds", "status"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "tenantId": { "$ref": "#/$defs/Id" },
        "schemaVersion": { "const": "buyer-ops/0.3.0" },
        "recordType": { "$ref": "#/$defs/Id" },
        "version": { "type": "integer", "minimum": 1 },
        "createdAt": { "$ref": "#/$defs/Timestamp" },
        "updatedAt": { "$ref": "#/$defs/Timestamp" },
        "effectiveFrom": { "$ref": "#/$defs/Timestamp" },
        "effectiveTo": { "$ref": "#/$defs/Timestamp" },
        "createdBy": { "$ref": "#/$defs/ActorRef" },
        "sourceEvidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Id" }
        },
        "supersedesId": { "$ref": "#/$defs/Id" },
        "status": { "enum": ["active", "inactive", "superseded", "tombstoned", "invalid"] }
      }
    },
    "StringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "Tenant": {
      "allOf": [
        { "$ref": "#/$defs/CanonicalFields" },
        {
          "type": "object",
          "required": ["recordType", "deploymentMode", "locale", "policyProfileId", "tenantState"],
          "properties": {
            "recordType": { "const": "Tenant" },
            "deploymentMode": { "enum": ["managed_multi_tenant", "dedicated_brokerage"] },
            "locale": { "type": "string", "minLength": 2 },
            "policyProfileId": { "$ref": "#/$defs/Id" },
            "tenantState": { "enum": ["provisioning", "active", "suspended", "decommissioning", "decommissioned"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "Brokerage": {
      "allOf": [
        { "$ref": "#/$defs/CanonicalFields" },
        {
          "type": "object",
          "required": ["recordType", "legalName", "licenseNumber", "jurisdiction", "policyProfileId", "brokerageState"],
          "properties": {
            "recordType": { "const": "Brokerage" },
            "legalName": { "type": "string", "minLength": 1 },
            "licenseNumber": { "type": "string", "minLength": 1 },
            "jurisdiction": { "type": "string", "minLength": 2 },
            "policyProfileId": { "$ref": "#/$defs/Id" },
            "brokerageState": { "enum": ["pending_verification", "active", "suspended", "inactive"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "LicenseHolder": {
      "allOf": [
        { "$ref": "#/$defs/CanonicalFields" },
        {
          "type": "object",
          "required": ["recordType", "personId", "licenseNumber", "licenseType", "jurisdiction", "activeFrom", "licenseState"],
          "properties": {
            "recordType": { "const": "LicenseHolder" },
            "personId": { "$ref": "#/$defs/Id" },
            "licenseNumber": { "type": "string", "minLength": 1 },
            "licenseType": { "enum": ["broker", "associated_broker", "sales_agent"] },
            "jurisdiction": { "type": "string", "minLength": 2 },
            "sponsoringBrokerageId": { "$ref": "#/$defs/Id" },
            "activeFrom": { "$ref": "#/$defs/Timestamp" },
            "activeTo": { "$ref": "#/$defs/Timestamp" },
            "licenseState": { "enum": ["pending_verification", "active", "inactive", "suspended", "expired", "revoked"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ServicePrincipal": {
      "allOf": [
        { "$ref": "#/$defs/CanonicalFields" },
        {
          "type": "object",
          "required": ["recordType", "principalType", "credentialBindingIds", "allowedCapabilities", "principalState"],
          "properties": {
            "recordType": { "const": "ServicePrincipal" },
            "principalType": { "enum": ["buyer_operations_agent", "workflow_worker", "connector", "migration"] },
            "credentialBindingIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
            "allowedCapabilities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
            "principalState": { "enum": ["provisioning", "active", "suspended", "revoked"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ContactEndpointValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpointId", "type", "normalizedValue", "verificationState", "status"],
      "properties": {
        "endpointId": { "$ref": "#/$defs/Id" },
        "type": { "enum": ["email", "phone"] },
        "normalizedValue": { "type": "string", "minLength": 3 },
        "verificationState": { "enum": ["unverified", "provider_observed", "verified", "disputed"] },
        "status": { "enum": ["active", "temporarily_unavailable", "invalid", "suppressed"] }
      }
    },
    "Person": {
      "allOf": [
        { "$ref": "#/$defs/CanonicalFields" },
        {
          "type": "object",
          "required": ["recordType", "identityState", "displayName"],
          "properties": {
            "recordType": { "const": "Person" },
            "identityState": { "enum": ["provisional", "resolved", "ambiguous", "conflict"] },
            "displayName": { "type": "string" },
            "endpointIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
            "endpoints": { "type": "array", "items": { "$ref": "#/$defs/ContactEndpointValue" }, "deprecated": true }
          },
          "anyOf": [{ "required": ["endpointIds"] }, { "required": ["endpoints"] }]
        }
      ],
      "unevaluatedProperties": false
    },
    "ContactEndpoint": {
      "allOf": [
        { "$ref": "#/$defs/CanonicalFields" },
        {
          "type": "object",
          "required": ["recordType", "endpointType", "normalizedValue", "ownerType", "ownerId", "ownershipState", "verificationState", "contactabilityState"],
          "properties": {
            "recordType": { "const": "ContactEndpoint" },
            "endpointType": { "enum": ["email", "phone", "other"] },
            "normalizedValue": { "type": "string", "minLength": 3 },
            "ownerType": { "enum": ["person", "service_principal"] },
            "ownerId": { "$ref": "#/$defs/Id" },
            "ownershipState": { "enum": ["asserted", "authorized", "disputed", "revoked"] },
            "verificationState": { "enum": ["unverified", "provider_observed", "verified", "disputed"] },
            "contactabilityState": { "enum": ["unknown", "contactable", "temporarily_unavailable", "suppressed", "invalid"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "BuyingParty": {
      "allOf": [
        { "$ref": "#/$defs/CanonicalFields" },
        {
          "type": "object",
          "required": ["recordType", "members", "decisionAuthorityState"],
          "properties": {
            "recordType": { "const": "BuyingParty" },
            "members": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["personId", "role"],
                "properties": {
                  "personId": { "$ref": "#/$defs/Id" },
                  "role": { "enum": ["buyer", "co_buyer", "decision_participant", "observer"] }
                }
              }
            },
            "decisionAuthorityState": { "enum": ["unconfirmed", "individual", "joint", "delegated", "disputed"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "BuyerJourney": {
      "allOf": [
        { "$ref": "#/$defs/CanonicalFields" },
        {
          "type": "object",
          "required": ["recordType", "buyingPartyId", "ownerLicenseHolderId", "territory", "journeyState", "qualificationState", "representationState"],
          "properties": {
            "recordType": { "const": "BuyerJourney" },
            "buyingPartyId": { "$ref": "#/$defs/Id" },
            "ownerLicenseHolderId": { "$ref": "#/$defs/Id" },
            "territory": { "type": "string", "minLength": 1 },
            "leadSourceId": { "$ref": "#/$defs/Id" },
            "propertyReferenceIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
            "journeyState": {
              "enum": ["captured", "contacted", "qualifying", "nurture", "consultation_ready", "consultation_booked", "representation_pending", "represented", "searching", "under_contract", "closed", "suppressed", "ineligible", "released", "dormant", "blocked"]
            },
            "qualificationState": { "enum": ["not_started", "collecting", "sufficient_for_consult", "stale", "contradicted", "declined"] },
            "representationState": { "enum": ["unconfirmed", "not_represented", "agreement_pending", "represented", "non_representation_showing_only", "expired", "terminated", "conflict"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ConversationParticipant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participantType", "participantId", "role"],
      "properties": {
        "participantType": { "enum": ["person", "license_holder", "service_principal"] },
        "participantId": { "$ref": "#/$defs/Id" },
        "role": { "enum": ["buyer", "agent", "assistant", "observer", "external"] }
      }
    },
    "Conversation": {
      "allOf": [
        { "$ref": "#/$defs/CanonicalFields" },
        {
          "type": "object",
          "required": ["recordType", "channel", "participants", "externalThreadRefs", "conversationState"],
          "properties": {
            "recordType": { "const": "Conversation" },
            "channel": { "enum": ["email", "sms", "phone", "web_chat", "in_person", "other"] },
            "participants": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/ConversationParticipant" } },
            "primaryJourneyId": { "$ref": "#/$defs/Id" },
            "linkedJourneyIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
            "externalThreadRefs": { "$ref": "#/$defs/StringMap" },
            "conversationState": { "enum": ["open", "closed", "archived", "blocked"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "MessageRecipient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipientType", "recipientId"],
      "properties": {
        "recipientType": { "enum": ["person", "license_holder", "service_principal", "endpoint"] },
        "recipientId": { "$ref": "#/$defs/Id" }
      }
    },
    "Message": {
      "allOf": [
        { "$ref": "#/$defs/CanonicalFields" },
        {
          "type": "object",
          "required": ["recordType", "conversationId", "direction", "senderType", "senderId", "recipients", "bodyArtifactId", "sentOrReceivedAt", "deliveryState"],
          "properties": {
            "recordType": { "const": "Message" },
            "conversationId": { "$ref": "#/$defs/Id" },
            "direction": { "enum": ["inbound", "outbound", "internal"] },
            "senderType": { "enum": ["person", "license_holder", "service_principal", "endpoint"] },
            "senderId": { "$ref": "#/$defs/Id" },
            "recipients": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/MessageRecipient" } },
            "bodyArtifactId": { "$ref": "#/$defs/Id" },
            "sentOrReceivedAt": { "$ref": "#/$defs/Timestamp" },
            "providerMessageId": { "$ref": "#/$defs/Id" },
            "deliveryState": { "enum": ["observed", "queued", "sent", "delivered", "failed", "unknown_outcome", "suppressed"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ConsentGrant": {
      "allOf": [
        { "$ref": "#/$defs/CanonicalFields" },
        {
          "type": "object",
          "required": ["recordType", "personId", "channel", "purpose", "principalId", "basis", "grantedAt", "validityState"],
          "properties": {
            "recordType": { "const": "ConsentGrant" },
            "personId": { "$ref": "#/$defs/Id" },
            "endpointId": { "$ref": "#/$defs/Id" },
            "channel": { "enum": ["email", "sms", "phone", "form"] },
            "purpose": { "$ref": "#/$defs/Id" },
            "principalId": { "$ref": "#/$defs/Id" },
            "basis": { "enum": ["affirmative", "inbound_response_policy", "contractual", "other_approved"] },
            "grantedAt": { "$ref": "#/$defs/Timestamp" },
            "expiresAt": { "$ref": "#/$defs/Timestamp" },
            "presentationEvidenceId": { "$ref": "#/$defs/Id" },
            "validityState": { "enum": ["active", "expired", "revoked", "superseded", "disputed"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "Suppression": {
      "allOf": [
        { "$ref": "#/$defs/CanonicalFields" },
        {
          "type": "object",
          "required": ["recordType", "subjectId", "scope", "reason", "suppressedAt", "validityState"],
          "properties": {
            "recordType": { "const": "Suppression" },
            "subjectId": { "$ref": "#/$defs/Id" },
            "endpointId": { "$ref": "#/$defs/Id" },
            "scope": { "enum": ["channel_purpose", "channel_all", "all_marketing", "all_non_required_contact"] },
            "reason": { "enum": ["opt_out", "invalid_endpoint", "policy", "legal", "agent_hold"] },
            "suppressedAt": { "$ref": "#/$defs/Timestamp" },
            "validityState": { "enum": ["active", "lifted", "superseded"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "LeadSource": {
      "allOf": [
        { "$ref": "#/$defs/CanonicalFields" },
        {
          "type": "object",
          "required": ["recordType", "sourceType", "attributedAt", "parameters", "attributionState"],
          "properties": {
            "recordType": { "const": "LeadSource" },
            "sourceType": { "enum": ["direct", "referral", "portal", "advertising", "event", "brokerage", "other"] },
            "campaign": { "type": "string" },
            "parameters": { "$ref": "#/$defs/StringMap" },
            "attributedAt": { "$ref": "#/$defs/Timestamp" },
            "evidenceId": { "$ref": "#/$defs/Id" },
            "attributionState": { "enum": ["observed", "confirmed", "disputed", "superseded"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "QualificationCriterion": {
      "allOf": [
        { "$ref": "#/$defs/CanonicalFields" },
        {
          "type": "object",
          "required": ["recordType", "criterionCode", "purpose", "allowedObservationStates", "freshnessSeconds", "criterionState"],
          "properties": {
            "recordType": { "const": "QualificationCriterion" },
            "criterionCode": { "$ref": "#/$defs/Id" },
            "purpose": { "type": "string", "minLength": 1 },
            "allowedObservationStates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["unknown", "buyer_declined", "asserted", "verified", "inferred", "stale", "contradicted", "not_applicable"] } },
            "freshnessSeconds": { "type": "integer", "minimum": 1 },
            "criterionState": { "enum": ["draft", "active", "retired", "superseded"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "QualificationObservation": {
      "allOf": [
        { "$ref": "#/$defs/CanonicalFields" },
        {
          "type": "object",
          "required": ["recordType", "journeyId", "criterionId", "epistemicItemId", "observationState"],
          "properties": {
            "recordType": { "const": "QualificationObservation" },
            "journeyId": { "$ref": "#/$defs/Id" },
            "criterionId": { "$ref": "#/$defs/Id" },
            "epistemicItemId": { "$ref": "#/$defs/Id" },
            "observationState": { "enum": ["unknown", "buyer_declined", "asserted", "verified", "inferred", "stale", "contradicted", "not_applicable"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "BuyerRequirement": {
      "allOf": [
        { "$ref": "#/$defs/CanonicalFields" },
        {
          "type": "object",
          "required": ["recordType", "journeyId", "statedByPersonId", "assertionId", "predicate", "value", "priority", "requirementState"],
          "properties": {
            "recordType": { "const": "BuyerRequirement" },
            "journeyId": { "$ref": "#/$defs/Id" },
            "statedByPersonId": { "$ref": "#/$defs/Id" },
            "assertionId": { "$ref": "#/$defs/Id" },
            "predicate": { "$ref": "#/$defs/Id" },
            "value": {},
            "rangeMinimum": { "type": "number" },
            "rangeMaximum": { "type": "number" },
            "priority": { "enum": ["must_have", "strong_preference", "preference", "exploratory"] },
            "validFrom": { "$ref": "#/$defs/Timestamp" },
            "validTo": { "$ref": "#/$defs/Timestamp" },
            "requirementState": { "enum": ["asserted", "confirmed", "stale", "contradicted", "withdrawn", "superseded"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "FinancingReadiness": {
      "allOf": [
        { "$ref": "#/$defs/CanonicalFields" },
        {
          "type": "object",
          "required": ["recordType", "journeyId", "readinessState", "verificationSourceIds", "assessedAt", "freshUntil"],
          "properties": {
            "recordType": { "const": "FinancingReadiness" },
            "journeyId": { "$ref": "#/$defs/Id" },
            "readinessState": { "enum": ["unknown", "buyer_reported", "documentation_pending", "documented", "stale", "contradicted", "not_applicable"] },
            "verificationSourceIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
            "assessedAt": { "$ref": "#/$defs/Timestamp" },
            "freshUntil": { "$ref": "#/$defs/Timestamp" },
            "disclaimer": { "const": "operational_readiness_not_loan_qualification" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "Appointment": {
      "allOf": [
        { "$ref": "#/$defs/CanonicalFields" },
        {
          "type": "object",
          "required": ["recordType", "journeyId", "appointmentType", "participantIds", "startsAt", "endsAt", "timeZone", "appointmentState"],
          "properties": {
            "recordType": { "const": "Appointment" },
            "journeyId": { "$ref": "#/$defs/Id" },
            "appointmentType": { "$ref": "#/$defs/Id" },
            "participantIds": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/Id" } },
            "startsAt": { "$ref": "#/$defs/Timestamp" },
            "endsAt": { "$ref": "#/$defs/Timestamp" },
            "timeZone": { "$ref": "#/$defs/Id" },
            "locationOrMode": { "$ref": "#/$defs/Id" },
            "propertyReferenceId": { "$ref": "#/$defs/Id" },
            "providerEventId": { "$ref": "#/$defs/Id" },
            "providerVersion": { "$ref": "#/$defs/Id" },
            "appointmentState": { "enum": ["proposed", "held", "provider_pending", "confirmed", "completed", "cancelled", "no_show", "unknown_outcome"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "Commitment": {
      "allOf": [
        { "$ref": "#/$defs/CanonicalFields" },
        {
          "type": "object",
          "required": ["recordType", "journeyId", "obligorId", "beneficiaryIds", "description", "dueAt", "commitmentState"],
          "properties": {
            "recordType": { "const": "Commitment" },
            "journeyId": { "$ref": "#/$defs/Id" },
            "obligorId": { "$ref": "#/$defs/Id" },
            "beneficiaryIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Id" } },
            "description": { "type": "string", "minLength": 1 },
            "dueAt": { "$ref": "#/$defs/Timestamp" },
            "commitmentState": { "enum": ["open", "in_progress", "blocked", "fulfilled", "failed", "cancelled", "superseded"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "PropertyReference": {
      "allOf": [
        { "$ref": "#/$defs/CanonicalFields" },
        {
          "type": "object",
          "required": ["recordType", "addressText", "suppliedBy", "suppliedAt", "sourceType"],
          "properties": {
            "recordType": { "const": "PropertyReference" },
            "addressText": { "type": "string", "minLength": 1 },
            "suppliedBy": { "$ref": "#/$defs/ActorRef" },
            "suppliedAt": { "$ref": "#/$defs/Timestamp" },
            "sourceType": { "enum": ["buyer", "agent", "document", "other_manual"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "DocumentArtifact": {
      "allOf": [
        { "$ref": "#/$defs/CanonicalFields" },
        {
          "type": "object",
          "required": ["recordType", "digest", "storageRef", "mediaType", "retentionClass", "artifactState"],
          "properties": {
            "recordType": { "const": "DocumentArtifact" },
            "digest": { "$ref": "#/$defs/Digest" },
            "storageRef": { "type": "string", "minLength": 1 },
            "mediaType": { "type": "string", "minLength": 1 },
            "formId": { "$ref": "#/$defs/Id" },
            "formVersion": { "$ref": "#/$defs/Id" },
            "templateVersion": { "$ref": "#/$defs/Id" },
            "retentionClass": { "enum": ["transient", "operational", "regulatory", "agreement", "legal_hold"] },
            "artifactState": { "enum": ["pending", "active", "superseded", "deleted", "anonymized", "invalid"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
