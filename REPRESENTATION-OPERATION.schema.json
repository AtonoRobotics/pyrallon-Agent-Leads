{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buyer-ops.example/schemas/representation-operation/1.0.0",
  "title": "RepresentationOperationContract",
  "type": "object",
  "additionalProperties": false,
  "required": ["messageType", "schemaVersion", "tenantId", "journeyId", "decisionId", "representationState", "iabsNoticeRequired", "preconditions", "agreementRef", "derivedAt", "inputDigest", "evidenceIds"],
  "properties": {
    "messageType": { "const": "representation_decision" },
    "schemaVersion": { "const": "representation-operation/1.0.0" },
    "tenantId": { "type": "string", "minLength": 1 },
    "journeyId": { "type": "string", "minLength": 1 },
    "decisionId": { "type": "string", "minLength": 1 },
    "representationState": { "enum": ["not_presented", "pending_agent_approval", "presented", "partially_signed", "executed", "effective", "expired", "terminated", "blocked"] },
    "iabsNoticeRequired": { "type": "boolean" },
    "preconditions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "agreementRef": { "oneOf": [{ "$ref": "#/$defs/RecordRef" }, { "type": "null" }] },
    "derivedAt": { "type": "string", "format": "date-time" },
    "inputDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "evidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "RecordRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordId", "recordType", "version"],
      "properties": {
        "recordId": { "type": "string", "minLength": 1 },
        "recordType": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
