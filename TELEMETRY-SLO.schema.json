{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buyer-ops.example/schemas/telemetry-slo/1.0.0",
  "title": "TelemetrySloMessage",
  "oneOf": [
    {"$ref":"#/$defs/MetricObservation"},{"$ref":"#/$defs/SloEvaluation"},
    {"$ref":"#/$defs/DashboardDefinition"},{"$ref":"#/$defs/AlertEvent"}
  ],
  "$defs": {
    "Id":{"type":"string","minLength":1},
    "Time":{"type":"string","format":"date-time"},
    "Digest":{"type":"string","pattern":"^[a-zA-Z0-9_-]+:[a-fA-F0-9]{32,}$"},
    "Dimensions":{"type":"object","additionalProperties":false,"properties":{"environment":{"enum":["test","staging","production"]},"region":{"type":"string","minLength":1},"channel":{"enum":["web","ios","email","sms","voice","calendar","crm","internal"]},"provider":{"type":"string","minLength":1},"result":{"enum":["success","failure","blocked","unknown"]}}},
    "MetricObservation":{"type":"object","additionalProperties":false,"required":["messageType","schemaVersion","observationId","metricId","value","unit","eventStartedAt","eventEndedAt","observedAt","dimensions","sourceEventIds","producerId","retentionClass"],"properties":{"messageType":{"const":"metric_observation"},"schemaVersion":{"const":"telemetry-slo/1.0.0"},"observationId":{"$ref":"#/$defs/Id"},"metricId":{"$ref":"#/$defs/Id"},"value":{"type":"number"},"unit":{"enum":["seconds","count","ratio","boolean"]},"eventStartedAt":{"$ref":"#/$defs/Time"},"eventEndedAt":{"$ref":"#/$defs/Time"},"observedAt":{"$ref":"#/$defs/Time"},"dimensions":{"$ref":"#/$defs/Dimensions"},"sourceEventIds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/Id"}},"producerId":{"$ref":"#/$defs/Id"},"retentionClass":{"enum":["operational_90d","audit_7y"]}}},
    "SloEvaluation":{"type":"object","additionalProperties":false,"required":["messageType","schemaVersion","evaluationId","sloId","catalogVersion","windowStartedAt","windowEndedAt","sampleCount","objective","actual","comparator","status","errorBudgetConsumed","sourceDigest","evaluatedAt"],"properties":{"messageType":{"const":"slo_evaluation"},"schemaVersion":{"const":"telemetry-slo/1.0.0"},"evaluationId":{"$ref":"#/$defs/Id"},"sloId":{"$ref":"#/$defs/Id"},"catalogVersion":{"const":"telemetry-slo-catalog/1.0.0"},"windowStartedAt":{"$ref":"#/$defs/Time"},"windowEndedAt":{"$ref":"#/$defs/Time"},"sampleCount":{"type":"integer","minimum":0},"objective":{"type":"number"},"actual":{"type":["number","null"]},"comparator":{"enum":["lte","gte","eq"]},"status":{"enum":["pass","fail","insufficient_data"]},"errorBudgetConsumed":{"type":["number","null"],"minimum":0},"sourceDigest":{"$ref":"#/$defs/Digest"},"evaluatedAt":{"$ref":"#/$defs/Time"}}},
    "DashboardDefinition":{"type":"object","additionalProperties":false,"required":["messageType","schemaVersion","dashboardId","version","owner","metricIds","sloIds","refreshSeconds","retentionClass"],"properties":{"messageType":{"const":"dashboard_definition"},"schemaVersion":{"const":"telemetry-slo/1.0.0"},"dashboardId":{"$ref":"#/$defs/Id"},"version":{"type":"integer","minimum":1},"owner":{"enum":["product_operations","platform_operations","security_operations","broker_operations"]},"metricIds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/Id"}},"sloIds":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/Id"}},"refreshSeconds":{"type":"integer","minimum":30},"retentionClass":{"const":"audit_7y"}}},
    "AlertEvent":{"type":"object","additionalProperties":false,"required":["messageType","schemaVersion","alertId","policyId","sloEvaluationId","severity","owner","route","openedAt","state","retentionClass"],"properties":{"messageType":{"const":"alert_event"},"schemaVersion":{"const":"telemetry-slo/1.0.0"},"alertId":{"$ref":"#/$defs/Id"},"policyId":{"$ref":"#/$defs/Id"},"sloEvaluationId":{"$ref":"#/$defs/Id"},"severity":{"enum":["warning","critical"]},"owner":{"enum":["product_operations","platform_operations","security_operations","broker_operations"]},"route":{"enum":["pager","ticket","compliance_review"]},"openedAt":{"$ref":"#/$defs/Time"},"state":{"enum":["open","acknowledged","resolved"]},"retentionClass":{"const":"audit_7y"}}}
  }
}
