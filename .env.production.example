# Copy to .env.production and replace every placeholder before deployment.
POSTGRES_DB=buyer_ops
POSTGRES_USER=buyer_ops
POSTGRES_PASSWORD=replace-with-a-long-random-password
BUYER_OPS_CONTROL_TOKEN=replace-with-a-long-random-control-token
BUYER_OPS_PERMIT_SECRET=replace-with-at-least-32-random-bytes
BUYER_OPS_RELEASE_PUBLIC_KEYS_JSON={"release-key-1":"replace-with-base64url-ed25519-public-key"}
BUYER_OPS_JOURNEY_VIEW_POLICY_JSON={"compiler_version":"journey-view/1.0.0","blocker_bindings":{"identity_ambiguous":["identity","agent"],"contactability_conflict":["connector","agent"],"contactability_unknown":["connector","agent"],"acknowledgment_conflict":["consent","agent"],"acknowledgment_unknown_outcome":["consent","agent"],"qualification_stale":["cognition","agent"],"qualification_contradicted":["cognition","agent"],"qualification_declined":["cognition","agent"],"consultation_conflict":["calendar","agent"],"consultation_provider_pending":["calendar","agent"],"representation_conflict":["representation","agent"]}}
BUYER_OPS_ARTIFACT_ENCRYPTION_KEY_REF=replace-with-kms-key-version-reference
BUYER_OPS_ARTIFACT_ENCRYPTION_KEY_B64=replace-with-base64url-encoded-32-byte-data-key
BUYER_OPS_CONNECTOR_ADAPTER_SECRET=replace-with-at-least-16-random-bytes
BUYER_OPS_CONNECTOR_ADAPTERS_JSON=[{"connectorId":"replace-with-connector-id","endpoint":"https://adapter.example.com/v1/invoke","secretEnv":"BUYER_OPS_CONNECTOR_ADAPTER_SECRET","providerVersion":"replace-with-provider-version","timeoutSeconds":15}]
BUYER_OPS_CONNECTOR_INVENTORY_PUBLIC_KEYS_JSON={"replace-with-inventory-key-id":"replace-with-base64url-ed25519-public-key"}
# Optional direct provider adapters. Each credentialEnv must name a separately injected secret.
# BUYER_OPS_GOOGLE_CALENDAR_TOKEN=replace-with-oauth-access-token
# BUYER_OPS_MICROSOFT_GRAPH_TOKEN=replace-with-oauth-access-token
# BUYER_OPS_TWILIO_CREDENTIAL=accountSid:authToken
# BUYER_OPS_SENDGRID_TOKEN=replace-with-api-key
# BUYER_OPS_DOCUSIGN_TOKEN=replace-with-oauth-access-token
# DOCUSIGN_OAUTH_CLIENT_ID=replace-with-docusign-integration-key
# DOCUSIGN_OAUTH_CLIENT_SECRET=replace-with-docusign-oauth-secret
# DOCUSIGN_OAUTH_AUTHORIZE_URL=https://account-d.docusign.com/oauth/auth
# DOCUSIGN_OAUTH_TOKEN_URL=https://account-d.docusign.com/oauth/token
# DOCUSIGN_OAUTH_IDENTITY_URL=https://account-d.docusign.com/oauth/userinfo
# BUYER_OPS_DIRECT_PROVIDER_ADAPTERS_JSON=[{"connectorId":"calendar-google","provider":"google_calendar","credentialEnv":"BUYER_OPS_GOOGLE_CALENDAR_TOKEN","accountId":"primary","timeoutSeconds":20},{"connectorId":"calendar-microsoft","provider":"microsoft_graph","credentialEnv":"BUYER_OPS_MICROSOFT_GRAPH_TOKEN","accountId":"replace-with-user-id","timeoutSeconds":20},{"connectorId":"sms-twilio","provider":"twilio","credentialEnv":"BUYER_OPS_TWILIO_CREDENTIAL","accountId":"replace-with-account-sid","timeoutSeconds":20},{"connectorId":"email-sendgrid","provider":"sendgrid","credentialEnv":"BUYER_OPS_SENDGRID_TOKEN","timeoutSeconds":20},{"connectorId":"esign-docusign","provider":"docusign","credentialEnv":"BUYER_OPS_DOCUSIGN_TOKEN","accountId":"replace-with-docusign-account-id","timeoutSeconds":20}]
BUYER_OPS_COGNITIVE_ACTION_CLASSES=qualification,acknowledgment,consultation
BUYER_OPS_COGNITIVE_CONCURRENCY=2
BUYER_OPS_COGNITIVE_DATA_POLICY_VERSION=replace-with-approved-data-policy-version
# These four values are mandatory for live cognitive invocation. They contain policy,
# public identity/profile metadata, and HTTPS adapter references; credentials remain in
# the credentialEnv variables named by the runtime map and are never stored in policy.
BUYER_OPS_COGNITIVE_ROUTE_POLICY_JSON=
BUYER_OPS_COGNITIVE_IDENTITIES_JSON=
BUYER_OPS_COGNITIVE_PROFILES_JSON=
# A runtime may use protocol=openai_compatible with a modelId for a direct
# OpenAI-compatible HTTPS provider, or omit protocol for a product-owned /invoke adapter.
# Set credentialEnv to "database" when the identity is bound through the cognitive OAuth/API
# authorization flow; the runtime then decrypts the tenant-scoped credential from PostgreSQL.
# BUYER_OPS_COGNITIVE_RUNTIMES_JSON={"openai-chat":{"protocol":"openai_compatible","providerId":"openai","adapterVersion":"openai-compatible/1.0.0","endpoint":"https://api.openai.com","identityRef":"cognitive-openai-1","credentialEnv":"BUYER_OPS_OPENAI_API_KEY","modelId":"replace-with-approved-model","timeoutSeconds":60}}
BUYER_OPS_COGNITIVE_RUNTIMES_JSON=
# The secret itself is supplied separately; this JSON names its environment variable.
BUYER_OPS_INGRESS_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes
BUYER_OPS_INGRESS_PROVIDERS_JSON=[{"id":"primary-form","tenantId":"replace-with-tenant-id","providerAccountRef":"replace-with-provider-account-ref","channel":"form","recipientEndpoint":"replace-with-form-endpoint","signatureHeader":"x-provider-signature","secretEnv":"BUYER_OPS_INGRESS_WEBHOOK_SECRET","eventIdField":"event.id","senderField":"lead.email","displayNameField":"lead.name","threadIdField":"thread.id","retentionDays":365}]
BUYER_OPS_BOOTSTRAP_RECORDS_JSON=[{"id":"replace-with-license-holder-id","tenantId":"replace-with-tenant-id","schemaVersion":"buyer-ops/0.3.0","recordType":"LicenseHolder","version":1,"createdAt":"2030-01-01T00:00:00Z","updatedAt":"2030-01-01T00:00:00Z","effectiveFrom":"2030-01-01T00:00:00Z","createdBy":{"actorType":"system_migration","actorId":"bootstrap"},"sourceEvidenceIds":[],"status":"active","personId":"replace-with-license-holder-person-id","licenseNumber":"replace-with-license-number","licenseType":"sales_agent","jurisdiction":"TX","activeFrom":"2030-01-01T00:00:00Z","licenseState":"active"},{"schemaVersion":"open-025-027/1.0.0","recordType":"ActorTenantAuthorization","tenantId":"replace-with-tenant-id","recordId":"replace-with-authorization-id","observedAt":"2030-01-01T00:00:00Z","actorId":"replace-with-owner-actor-id","principalId":"replace-with-owner-principal-id","role":"agent","allowedCommands":["request_reconciliation"],"recordScopes":["journey"],"policyVersion":"replace-with-policy-id","authorizationVersion":1,"effectiveAt":"2030-01-01T00:00:00Z","expiresAt":"2031-01-01T00:00:00Z","status":"active"},{"message_type":"operator_policy","schema_version":"operator-surface/1.1.0","policy_id":"replace-with-policy-id","tenant_id":"replace-with-tenant-id","record_version":1,"effective_from":"2030-01-01T00:00:00Z","status":"active","command_rules":[{"command_type":"request_reconciliation","action_class":"request_reconciliation","target_record_types":["EffectAttempt"],"actor_types":["license_holder"]}],"evidence_refs":[{"record_id":"replace-with-evidence-id","record_type":"Evidence","version":1,"digest":"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","captured_at":"2030-01-01T00:00:00Z"}]}]
# Optional current canonical EffectPolicy records. Each record must be a
# signed/owned brokerage policy with one explicit rule per action class. The
# control plane remains fail-closed when this is omitted or ambiguous.
# BUYER_OPS_BOOTSTRAP_CLOSURE_RECORDS_JSON=[{"schemaVersion":"open-019-024/1.1.0","tenantId":"replace-with-tenant-id","recordId":"replace-with-effect-policy-record-id","recordVersion":1,"recordType":"EffectPolicy","observedAt":"2030-01-01T00:00:00Z","effectiveFrom":"2030-01-01T00:00:00Z","status":"current","evidenceRefs":["replace-with-policy-evidence-id"],"policyId":"replace-with-effect-policy-id","policyVersion":"replace-with-effect-policy-version","rules":[{"actionClass":"replace-with-action-class","disposition":"approval_required"}],"expiresAt":"2031-01-01T00:00:00Z"}]
TEMPORAL_ADDRESS=host.docker.internal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=replace-with-tenant-isolated-task-queue
TEMPORAL_RUNTIME_POLICY_JSON={"start_to_close_seconds":30,"initial_retry_seconds":2,"backoff_coefficient":2,"maximum_retry_seconds":60,"maximum_attempts":3}
TEMPORAL_WORKER_CONFIGURATION_JSON={"message_type":"worker_configuration","schema_version":"buyer-ops-temporal-worker/1.0.0","task_queue":"buyer-journey-production","max_concurrent_workflow_tasks":20,"max_concurrent_activities":20,"max_cached_workflows":100,"graceful_shutdown_seconds":30}
BUYER_OPS_OUTBOX_TENANTS=replace-with-tenant-id
BUYER_OPS_QUALIFICATION_POLICY_JSON=replace-with-published-qualification-policy-json
BUYER_OPS_QUALIFICATION_RUNTIME_JSON=replace-with-published-qualification-runtime-json
BUYER_OPS_NURTURE_POLICY_JSON=replace-with-published-nurture-policy-json
BUYER_OPS_NURTURE_RUNTIME_JSON=replace-with-published-nurture-runtime-json
# Optional until the broker publishes reminder cadence, channels, and evidence.
# BUYER_OPS_REMINDER_POLICY_JSON={"messageType":"reminder_policy","schemaVersion":"consultation-operation/1.0.0","tenantId":"replace-with-tenant-id","id":"reminder-policy-v1","version":1,"lifecycle":"active","offsetSeconds":[86400,3600],"channels":["email"],"sourceEvidenceIds":["replace-with-policy-evidence"]}
BUYER_OPS_PUBLISHED_CONTROL_PORT=8090
# Required before any non-loopback Google, Microsoft, or DocuSign OAuth grant.
# The HTTPS origin must publish this deployment's /api/connectors/callback route.
OPERATOR_PUBLIC_URL=https://operator.example.com
# The live proof runners must use an already authorized actor in the target tenant.
BUYER_OPS_PRODUCTION_BASE=http://127.0.0.1:8090
BUYER_OPS_E2E_TENANT=replace-with-authorized-tenant-id
BUYER_OPS_E2E_ACTOR=replace-with-authorized-actor-id
